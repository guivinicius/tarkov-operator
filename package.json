{
  "name": "tarkov-operator-desktop",
  "version": "0.1.0",
  "description": "Desktop AI companion for Escape from Tarkov — push-to-talk, system tray, game-aware RAG",
  "main": "src/main.js",
  "license": "MIT",
  "author": "Guilherme Vinicius Moreira",
  "repository": "github:guivinicius/tarkov-operator",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "ELECTRON_RUN_AS_NODE=1 electron --test tests/*.test.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build": "electron-builder --mac --win"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.tarkov-operator.desktop",
    "productName": "Tarkov Operator",
    "asarUnpack": ["node_modules/better-sqlite3/**"],
    "files": [
      "src/**/*",
      "data/**/*",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "guivinicius",
        "repo": "tarkov-operator"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tarkov Operator uses the microphone for push-to-talk questions."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
