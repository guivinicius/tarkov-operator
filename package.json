{
  "name": "tarkov-operator-desktop",
  "version": "0.1.0-beta.7",
  "description": "Desktop AI companion for Escape from Tarkov — push-to-talk, system tray, game-aware RAG",
  "main": "src/main.js",
  "license": "MIT",
  "author": "Guilherme Vinicius Moreira",
  "repository": "github:guivinicius/tarkov-operator",
  "private": true,
  "bugs": {
    "url": "https://github.com/guivinicius/tarkov-operator/issues"
  },
  "homepage": "https://github.com/guivinicius/tarkov-operator#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/*.test.js",
    "lint": "eslint src/ tests/",
    "format:check": "prettier --check 'src/**/*.{js,css,html}' 'tests/**/*.js'",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build": "electron-builder --mac --win"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "openai": "^4.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "com.tarkov-operator.desktop",
    "productName": "Tarkov Operator",
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/uiohook-napi/**"
    ],
    "files": [
      "src/**/*",
      "data/**/*",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "guivinicius",
        "repo": "tarkov-operator"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tarkov Operator uses the microphone for push-to-talk questions.",
        "NSScreenCaptureUsageDescription": "Tarkov Operator captures a screenshot when you use push-to-talk to give the AI visual context."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
